#!/usr/bin/env php
<?php

use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\ConsoleOutput;
use Symfony\Component\Console\Output\OutputInterface;
use Waynestate\Proctor\Check\CheckInterface;
use Waynestate\Proctor\Check\CheckRunner;
use Waynestate\Proctor\Check\CiPipelinesCheck;
use Waynestate\Proctor\Check\ComposerAuditCheck;
use Waynestate\Proctor\Check\ComposerConfigCheck;
use Waynestate\Proctor\Check\ComposerVersionCheck;
use Waynestate\Proctor\Check\DestructiveDeployCheck;
use Waynestate\Proctor\Check\Finding;
use Waynestate\Proctor\Check\LockCommittedCheck;
use Waynestate\Proctor\Check\Mysql56Check;
use Waynestate\Proctor\Check\OverridesCheck;
use Waynestate\Proctor\Check\PhpFloorCheck;
use Waynestate\Proctor\Check\PolicyAgeCheck;
use Waynestate\Proctor\Check\PortabilityCheck;
use Waynestate\Proctor\Check\RepoUrlCredentialsCheck;
use Waynestate\Proctor\Check\UnboundedConstraintsCheck;
use Waynestate\Proctor\Check\UnpatchedCheck;
use Waynestate\Proctor\Override\OverrideFile;
use Waynestate\Proctor\Policy\PolicyResolver;
use Waynestate\Proctor\Report\CodeQualityWriter;
use Waynestate\Proctor\Report\JsonWriter;
use Waynestate\Proctor\Report\Report;
use Waynestate\Proctor\Report\ReportWriter;
use Waynestate\Proctor\Report\SarifWriter;
use Waynestate\Proctor\Report\TextWriter;
use Waynestate\Proctor\ToolError;

// Installed as a dependency, Composer's bin proxy tells us where the host app's autoloader is.
// Run from a checkout of PROCTOR itself, it is our own vendor/autoload.php. Either way, one roll call.
$autoload = $GLOBALS['_composer_autoload_path'] ?? null;
if (!is_string($autoload) || !is_file($autoload)) {
    $autoload = null;
    foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
        if (is_file($candidate)) {
            $autoload = $candidate;
            break;
        }
    }
}
if ($autoload === null) {
    fwrite(STDERR, "vendor/autoload.php not found. Run `composer install` first.\n");
    exit(2);
}

require $autoload;

// A shared host may cap PHP at 128M, and scanning a large app's syntax trees
// needs more room. Raise a low limit to 512M, but never lower a higher one
// and never touch -1 (unlimited).
$limit = (string) ini_get('memory_limit');
if (preg_match('/^(\d+)\s*([KMG])?B?$/i', trim($limit), $m) === 1) {
    $bytes = (int) $m[1] * match (strtoupper($m[2] ?? '')) {
        'K' => 1024,
        'M' => 1024 * 1024,
        'G' => 1024 * 1024 * 1024,
        default => 1,
    };
    if ($bytes < 512 * 1024 * 1024) {
        ini_set('memory_limit', '512M');
    }
}

$application = new class (Report::TOOL, Report::version()) extends Application {
    public function doRun(InputInterface $input, OutputInterface $output): int
    {
        $errorOutput = $output instanceof ConsoleOutput ? $output->getErrorOutput() : $output;
        $name = $this->getCommandName($input);
        if (null !== $name && '' !== $name && !$this->has($name)) {
            $errorOutput->writeln(sprintf('Command "%s" is not defined.', $name));
            return 2;
        }

        return parent::doRun($input, $output);
    }
};

$application->addCommand(new class () extends Command {
    protected function configure(): void
    {
        $this
            ->setName('check')
            ->setDescription('Measure a PHP app against the version policy.')
            ->addOption('path', null, InputOption::VALUE_REQUIRED, 'Path to the application to check.', '.')
            ->addOption('format', null, InputOption::VALUE_REQUIRED, 'Output format (text, json, codequality, sarif).', 'text')
            ->addOption('policy', null, InputOption::VALUE_REQUIRED, "Path to the CREED-format policy file. Without it, PROCTOR checks the PROCTOR_POLICY environment variable, then the app's vendor/waynestate/creed/policy/policy.json, then its own bundled copy.")
            ->addOption('today', null, InputOption::VALUE_REQUIRED, "Override today's date (YYYY-MM-DD).")
            ->addOption('php-runtime', null, InputOption::VALUE_REQUIRED, 'The PHP version that will serve the app (X.Y.Z), for the unpatched check.')
            ->addOption('timeout', null, InputOption::VALUE_REQUIRED, 'Maximum seconds for composer audit before it is killed.', '300');
    }

    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $errorOutput = $output instanceof ConsoleOutput ? $output->getErrorOutput() : $output;

        $format = (string) $input->getOption('format');
        if (!in_array($format, ['text', 'json', 'codequality', 'sarif'], true)) {
            $errorOutput->writeln(sprintf(
                'Invalid format "%s". Allowed values: text, json, codequality, sarif.',
                $format
            ));
            return 2;
        }

        $appPath = (string) $input->getOption('path');

        try {
            $resolved = PolicyResolver::resolve(
                $input->getOption('policy'),
                $appPath,
                static function (string $note) use ($errorOutput): void {
                    $errorOutput->writeln($note);
                },
            );
        } catch (InvalidArgumentException | RuntimeException $e) {
            $errorOutput->writeln($e->getMessage());
            return 2;
        }
        $policy = $resolved->policy;

        $todayOption = $input->getOption('today');
        if (null === $todayOption) {
            $today = new \DateTimeImmutable('today');
        } else {
            $today = \DateTimeImmutable::createFromFormat('!Y-m-d', $todayOption);
            if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $todayOption) || false === $today) {
                $errorOutput->writeln(sprintf(
                    'Invalid --today value "%s". Expected format: YYYY-MM-DD.',
                    $todayOption
                ));
                return 2;
            }
        }

        $timeoutOption = (string) $input->getOption('timeout');
        if (!preg_match('/^\d+$/', $timeoutOption) || (int) $timeoutOption < 1) {
            $errorOutput->writeln(sprintf(
                'Invalid --timeout value "%s". Expected a positive integer number of seconds.',
                $timeoutOption
            ));
            return 2;
        }
        $timeout = (int) $timeoutOption;

        $phpRuntimeOption = $input->getOption('php-runtime');
        $phpRuntime = null;
        if (null !== $phpRuntimeOption && '' !== $phpRuntimeOption) {
            if (!preg_match('/^\d+\.\d+\.\d+$/', $phpRuntimeOption)) {
                $errorOutput->writeln(sprintf(
                    'Invalid --php-runtime value "%s". Expected format: X.Y.Z (digits and dots only).',
                    $phpRuntimeOption
                ));
                return 2;
            }
            $phpRuntime = $phpRuntimeOption;
        }

        try {
            $overrides = OverrideFile::load($appPath);
            $composerVersionCheck = new ComposerVersionCheck();
            $checks = [
                new PhpFloorCheck(),
                new UnpatchedCheck(),
                new UnboundedConstraintsCheck(),
                new ComposerConfigCheck(),
                new LockCommittedCheck(),
                new PortabilityCheck(),
                new Mysql56Check(),
                new DestructiveDeployCheck(),
                new CiPipelinesCheck(),
                new ComposerAuditCheck(),
                $composerVersionCheck,
                new RepoUrlCredentialsCheck(),
                new OverridesCheck(),
                new PolicyAgeCheck($resolved),
            ];
            // The ids come from the registered checks, so a new check needs
            // no change here.
            OverrideFile::assertKnownChecks(
                $overrides,
                array_map(fn (CheckInterface $check) => $check->id(), $checks),
            );
            $runner = new CheckRunner(
                $appPath,
                $policy,
                $today,
                $checks,
                $overrides,
                $timeout,
                $phpRuntime
            );
            $findings = $runner->run();
        } catch (ToolError $e) {
            $errorOutput->writeln($e->getMessage());
            if ('codequality' === $format) {
                $output->writeln((new CodeQualityWriter())->writeToolError($e->getMessage()));
            }
            return 2;
        }

        $hasFail = false;
        foreach ($findings as $finding) {
            if (Finding::STATUS_FAIL === $finding->status) {
                $hasFail = true;
            }
        }

        $report = new Report(
            $appPath,
            $today,
            $findings,
            $overrides,
            $hasFail ? Report::EXIT_FAIL : Report::EXIT_PASS,
            $resolved,
            ['composer' => $composerVersionCheck->composerVersion]
        );

        try {
            $output->writeln($this->writerFor($format)->write($report));
        } catch (ToolError $e) {
            $errorOutput->writeln($e->getMessage());
            return 2;
        }

        return $report->exitCode;
    }

    private function writerFor(string $format): ReportWriter
    {
        return match ($format) {
            'text' => new TextWriter(),
            'json' => new JsonWriter(),
            'codequality' => new CodeQualityWriter(),
            'sarif' => new SarifWriter(),
            default => throw new ToolError(sprintf('Unknown output format "%s".', $format)),
        };
    }
});

exit($application->run());
