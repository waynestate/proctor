{
    "name": "waynestate/proctor",
    "description": "A framework-free PHP CLI that measures a PHP app against the version policy.",
    "homepage": "https://proctor.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/proctor"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.1",
        "symfony/yaml": "^7.1",
        "composer/semver": "^3.4",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "humbug/box": "4.7.1",
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1",
        "waynestate/pinstripe": "^0.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "creed-copy:check": "php scripts/creed-copy-check.php",
        "site:agent-ready": "php bin/agent-ready.php",
        "site:agent-ready-check": "php bin/agent-ready.php --check",
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@site:agent-ready-check",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: manifest, tests, style, static analysis, agent-ready files, audit",
        "creed-copy:check": "Verify the generated CREED reader copy in src/Creed/ matches a fresh export (set CREED_PATH to the CREED checkout)",
        "site:agent-ready": "Rewrite the Markdown twins, llms.txt, llms-full.txt, robots.txt and sitemap.xml in site/ (Squire's agent-ready kit).",
        "site:agent-ready-check": "Fail when the agent-ready files are stale, a page lacks its Markdown link, a prompt drifts from the docs, or the kit was edited here."
    },
    "bin": [
        "bin/proctor"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Proctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Proctor\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
