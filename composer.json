{
    "name": "waynestate/proctor",
    "description": "A framework-free PHP CLI that measures a PHP app against the version policy.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/console": "^7.1",
        "composer/semver": "^3.4",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": [
            "@composer validate --strict",
            "phpunit",
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Run every CI check: manifest, tests, style, static analysis, audit"
    },
    "bin": [
        "bin/proctor"
    ],
    "autoload": {
        "psr-4": {
            "Waynestate\\Proctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Waynestate\\Proctor\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
